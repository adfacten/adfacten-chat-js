{
  "name": "@adfacten/chat",
  "version": "1.0.0",
  "description": "Sponsored product recommendations for chat apps, assistants and bots, from the Adfacten network.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/chat-1.0.0.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "adfacten",
    "chatbot",
    "assistant",
    "recommendations",
    "affiliate",
    "sponsored"
  ],
  "homepage": "https://developers.adfacten.com/ai-recommendations-en",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run -s typecheck && npm run -s test && npm run -s build"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^27.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adfacten/adfacten-chat-js.git"
  },
  "bugs": {
    "url": "https://github.com/adfacten/adfacten-chat-js/issues"
  }
}
